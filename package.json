{
  "name": "fold-note",
  "displayName": "FoldNote",
  "description": "Fold code sections, attach notes, and highlight passages — without modifying your source files.",
  "version": "0.0.1",
  "publisher": "der-feb",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Der-Feb/fold-note"
  },
  "categories": ["Other"],
  "keywords": ["fold", "notes", "highlight", "annotations", "code reading"],
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "foldNote",
          "title": "FoldNote",
          "icon": "sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "foldNote": [
        {
          "id": "foldNote.annotationsView",
          "name": "Annotations",
          "icon": "sidebar-icon.svg",
          "contextualTitle": "FoldNote"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "foldNote.annotationsView",
        "contents": "No annotations yet.\n\nSelect some lines in the editor and run a FoldNote command to get started.\n\n[Open Command Palette](command:workbench.action.showCommands)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "foldNote.deleteAnnotation",
          "when": "viewItem =~ /foldNote\\.(folder|highlight|conflicted)/",
          "group": "inline@2"
        },
        {
          "command": "foldNote.unfoldAnnotation",
          "when": "viewItem == foldNote.folder",
          "group": "inline@1"
        }
      ]
    },
    "commands": [
      {
        "command": "foldNote.helloWorld",
        "title": "FoldNote: Hello World"
      },
      {
        "command": "foldNote.spikeFoldSelection",
        "title": "FoldNote Spike: Fold — From Selection"
      },
      {
        "command": "foldNote.spikeFoldInput",
        "title": "FoldNote Spike: Fold — From Input"
      },
      {
        "command": "foldNote.spikeHighlightSelection",
        "title": "FoldNote Spike: Highlight — From Selection"
      },
      {
        "command": "foldNote.spikeHighlightInput",
        "title": "FoldNote Spike: Highlight — From Input"
      },
      {
        "command": "foldNote.spikeUnfold",
        "title": "FoldNote Spike: Unfold"
      },
      {
        "command": "foldNote.spikeClearHighlight",
        "title": "FoldNote Spike: Clear Highlight"
      },
      {
        "command": "foldNote.spikeRefresh",
        "title": "FoldNote Spike: Refresh folding ranges"
      },
      {
        "command": "foldNote.refreshView",
        "title": "FoldNote: Refresh Sidebar",
        "icon": "$(refresh)"
      },
      {
        "command": "foldNote.revealAnnotation",
        "title": "FoldNote: Reveal Annotation"
      },
      {
        "command": "foldNote.deleteAnnotation",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "foldNote.unfoldAnnotation",
        "title": "Unfold",
        "icon": "$(fold-up)"
      },
      {
        "command": "foldNote.foldSelection",
        "title": "FoldNote: Fold Selection with Note"
      },
      {
        "command": "foldNote.unfoldAtCursor",
        "title": "FoldNote: Unfold at Cursor"
      },
      {
        "command": "foldNote.toggleAllNotes",
        "title": "FoldNote: Toggle All Notes"
      },
      {
        "command": "foldNote.refreshRanges",
        "title": "FoldNote: Refresh Ranges"
      },
      {
        "command": "foldNote.codeLensClicked",
        "title": "FoldNote: CodeLens Clicked"
      }
    ],
    "keybindings": [
      {
        "command": "foldNote.foldSelection",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "editorTextFocus"
      },
      {
        "command": "foldNote.unfoldAtCursor",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "FoldNote",
      "properties": {
        "foldNote.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens indicators above annotations."
        },
        "foldNote.badgePrefix": {
          "type": "string",
          "default": "📝 ",
          "description": "Prefix shown before fold note labels."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "dev": "npm run build && code --extensionDevelopmentPath=\"$(pwd)\" --disable-extensions .",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTests.js",
    "compile-tests": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.6",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.14.0",
    "mocha": "^10.8.2",
    "typescript": "^5.6.3"
  }
}
